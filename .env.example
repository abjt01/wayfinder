# Get a free key at https://console.groq.com/keys
# Both are optional: with neither set, Wayfinder runs on its local engine.

# One key.
GROQ_API_KEY=gsk_your_key_here

# Or several, comma separated. Requests round-robin across them, and a key
# that gets rate limited sits out until its window resets, which raises the
# ceiling set by Groq's per-key limits. Neither variable wins: both are
# merged into one pool, so you can set either or both.
# GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three

GROQ_MODEL=llama-3.3-70b-versatile

# Point at an OpenAI-compatible proxy, or a stub in tests. Defaults to Groq.
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
